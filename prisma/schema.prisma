// Prisma schema; the database URL lives in prisma.config.ts (Prisma 7).
// Models are added in their own features.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One day of the timesheet; ids are generated by the application.
model TimesheetPage {
  id        String           @id
  date      String
  createdAt DateTime         @default(now())
  entries   TimesheetEntry[]
}

// One table row; values are text so that unvalidated input can be stored.
model TimesheetEntry {
  id                  String        @id
  pageId              String
  page                TimesheetPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sorting             Int
  startTime           String        @default("")
  endTime             String        @default("")
  duration            String        @default("")
  ticketId            String?
  ticket              Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  bookingText         String        @default("")
  bookingTextInternal String        @default("")
  bookingTextReviewed String        @default("")
  // Displayed text and duration right after the last review, as JSON; tells
  // whether the entry changed since.
  reviewedValues      String        @default("")
  // Transfer to Odoo: the timesheet line, the transferred values as JSON (to
  // detect later changes) and the message of the last failed transfer.
  odooTimesheetId     Int?
  transferredValues   String        @default("")
  transferError       String        @default("")

  @@index([pageId, sorting])
}

// A ticket from Odoo, stored when it is looked up; ids are generated by the application.
// The base for recent tickets and favorites of the later ticket finder.
model Ticket {
  id               String           @id
  // "helpdesk" (helpdesk.ticket) or "project" (project.task).
  type             String
  // Odoo record id; the number shown in Odoo can differ (helpdesk ticket_ref).
  odooId           Int
  number           String
  title            String
  // Project of the ticket; timesheet lines need it.
  projectOdooId    Int?
  allowsTimesheets Boolean          @default(false)
  lastUsedAt       DateTime         @default(now())
  entries          TimesheetEntry[]

  @@unique([type, odooId])
}
