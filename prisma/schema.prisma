// Prisma schema; the database URL lives in prisma.config.ts (Prisma 7).
// Models are added in their own features.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One day of the timesheet; ids are generated by the application.
model TimesheetPage {
  id         String           @id
  date       String
  createdAt  DateTime         @default(now())
  // Null while the page is not archived; archived pages leave the pagination.
  archivedAt DateTime?
  entries    TimesheetEntry[]
}

// One table row; values are text so that unvalidated input can be stored.
model TimesheetEntry {
  id                  String        @id
  pageId              String
  page                TimesheetPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sorting             Int
  startTime           String        @default("")
  endTime             String        @default("")
  duration            String        @default("")
  ticketId            String?
  ticket              Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  bookingText         String        @default("")
  bookingTextInternal String        @default("")
  bookingTextReviewed String        @default("")
  // Displayed text and duration right after the last review, as JSON; tells
  // whether the entry changed since.
  reviewedValues      String        @default("")
  // Transfer to Odoo: the timesheet line, the transferred values as JSON (to
  // detect later changes) and the message of the last failed transfer.
  odooTimesheetId     Int?
  transferredValues   String        @default("")
  transferError       String        @default("")

  @@index([pageId, sorting])
}

// A ticket from Odoo, stored when it is looked up; ids are generated by the application.
// The base for recent tickets and favorites of the later ticket finder.
model Ticket {
  id               String           @id
  // "helpdesk" (helpdesk.ticket) or "project" (project.task).
  type             String
  // Odoo record id; the number shown in Odoo can differ (helpdesk ticket_ref).
  odooId           Int
  number           String
  title            String
  // Project of the ticket; timesheet lines need it.
  projectOdooId    Int?
  allowsTimesheets Boolean          @default(false)
  lastUsedAt       DateTime         @default(now())
  // Helpdesk team of a ticket or project of a task.
  groupId          String?
  group            TicketGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Set while the ticket is a favorite of the ticket picker.
  favoritedAt      DateTime?
  entries          TimesheetEntry[]

  @@unique([type, odooId])
}

// A helpdesk team ("helpdesk") or a project ("project") from Odoo; stored when
// a ticket of it is stored or the group is pinned or opened in the ticket picker.
model TicketGroup {
  id         String    @id
  type       String
  odooId     Int
  name       String
  // Customer of a project; teams have none in Odoo.
  customer   String    @default("")
  pinnedAt   DateTime?
  lastUsedAt DateTime?
  tickets    Ticket[]

  @@unique([type, odooId])
}

// A customer requirement of Ticket Forge, prepared for an Odoo ticket; ids are
// generated by the application.
model Requirement {
  id                  String    @id
  // Empty until set by the user or generated by the AI.
  title               String    @default("")
  // The original text from notes or an email; never changed after creation.
  rawText             String
  // Markdown, converted to Odoo HTML on transfer.
  description         String    @default("")
  internalDescription String    @default("")
  // "draft" or "prepared"; later "transferred".
  status              String    @default("draft")
  // Claude's notes for the author: missing information, contradictions,
  // assumptions; replaced by every AI run and not transferred.
  aiFeedback          String    @default("")
  // Title, descriptions and status before the last AI run as JSON, for a
  // one-step undo; empty if there is nothing to undo.
  previousValues      String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Null while the requirement is not archived; archived ones leave the list.
  archivedAt          DateTime?

  @@index([archivedAt, updatedAt])
}
