# Copy to .env; relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Claude API, see docs/guides/claude-api.md; the key is only read on the server.
ANTHROPIC_API_KEY=""
# Model and effort per feature; effort: low | medium | high | xhigh | max.
# Booking text review of the timesheet.
BOOKING_REVIEW_MODEL="claude-sonnet-5-5"
BOOKING_REVIEW_EFFORT="low"
# Preparation of Ticket Forge requirements.
TICKET_FORGE_MODEL="claude-sonnet-5-5"
TICKET_FORGE_EFFORT="medium"

# Odoo links of the ticket field; {id} is replaced by the Odoo record id.
# Without a URL the ticket field shows no link for that type.
ODOO_HELPDESK_TICKET_URL="https://odoo.datamints.com/odoo/helpdesk.ticket/{id}"
ODOO_PROJECT_TASK_URL="https://odoo.datamints.com/odoo/project.task/{id}"
# Links of the team or project chosen in Ticket Forge.
ODOO_HELPDESK_TEAM_URL="https://odoo.datamints.com/odoo/helpdesk/{id}/tickets"
ODOO_PROJECT_URL="https://odoo.datamints.com/odoo/action-393/{id}"

# Odoo JSON-2 API, see docs/guides/odoo.md; the key is only read on the server.
ODOO_URL="https://odoo.datamints.com"
ODOO_API_KEY=""
# Only needed if the server hosts several databases and cannot tell them apart.
ODOO_DATABASE=""
# Stage of new helpdesk tickets from Ticket Forge; it must exist in the team and
# must not send a mail, otherwise the transfer stops.
ODOO_HELPDESK_STAGE="Neu ohne Mail"
