# Copy to .env; relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Claude API, see docs/guides/claude-api.md; the key is only read on the server.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT="low"

# Odoo links of the ticket field; {id} is replaced by the Odoo record id.
# Without a URL the ticket field shows no link for that type.
ODOO_HELPDESK_TICKET_URL="https://odoo.datamints.com/odoo/helpdesk.ticket/{id}"
ODOO_PROJECT_TASK_URL="https://odoo.datamints.com/odoo/project.task/{id}"
